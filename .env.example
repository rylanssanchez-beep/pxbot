# Copy this file to .env and fill in your real TradeLocker credentials.
# .env is gitignored — it is never committed, never logged, never printed.
PXBOT_EMAIL=you@example.com
PXBOT_PASSWORD=your-tradelocker-password
PXBOT_SERVER=YourBrokerServerName

# Optional fallback data source (Part 2's source hierarchy, tier 2/3) — only
# used if/when TradeLocker history is insufficient. Alpha Vantage does not
# offer CME NQ futures data directly; if used at all it would be for a
# clearly-labeled, separately-reported proxy instrument (e.g. QQQ), never
# silently merged with TradeLocker NAS100 bars. See DATA_AUDIT.md.
ALPHAVANTAGE_API_KEY=your-alphavantage-key
